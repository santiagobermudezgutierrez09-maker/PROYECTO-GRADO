rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function esPropietario(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    function idPerteneceAlUsuario(documentId) {
      return autenticado()
        // Limita el UID a caracteres seguros para insertarlo en la expresión regular.
        && request.auth.uid.matches('^[A-Za-z0-9_-]+$')
        && documentId.matches('^' + request.auth.uid + '_[^/]+$');
    }

    match /usuarios/{uid} {
      allow read, write: if esPropietario(uid);
    }

    match /favoritos/{documentId} {
      allow read, write: if idPerteneceAlUsuario(documentId);
    }

    match /calificaciones/{documentId} {
      allow read, write: if idPerteneceAlUsuario(documentId);
    }

    match /comentarios/{comentarioId} {
      allow read: if true;
      allow create: if autenticado()
        && request.resource.data.usuarioId == request.auth.uid;
      allow update: if autenticado()
        && resource.data.usuarioId == request.auth.uid
        && request.resource.data.usuarioId == request.auth.uid;
      allow delete: if autenticado()
        && resource.data.usuarioId == request.auth.uid;
    }

    match /listaCompras/{uid} {
      allow read, write: if esPropietario(uid);
    }

    match /eventos/{eventoId} {
      allow read: if autenticado()
        && resource.data.usuarioId == request.auth.uid;
      allow create: if autenticado()
        && request.resource.data.usuarioId == request.auth.uid;
      allow update: if autenticado()
        && resource.data.usuarioId == request.auth.uid
        && request.resource.data.usuarioId == request.auth.uid;
      allow delete: if autenticado()
        && resource.data.usuarioId == request.auth.uid;
    }

    // Todo documento que no coincida con las colecciones anteriores queda denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
